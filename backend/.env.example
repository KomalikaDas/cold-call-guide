# Supabase: Project Settings > Data API (URL) and Project Settings > API Keys (secret key).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Google AI Studio key. Without it the outcome check falls back to plain rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Comma-separated list of sites allowed to call the API, or * for any.
ALLOWED_ORIGINS=*
